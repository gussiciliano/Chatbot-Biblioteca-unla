# Plantilla de configuración. Copiala como .env y completá los valores:
# cp .env.example .env
# El archivo .env nunca se sube al repositorio (está en el .gitignore).


# Base de datos MySQL
# Formato:  jdbc:mysql://<host>:<puerto>/<base>?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true


DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Correo saliente (cuenta de Gmail con contraseña de aplicación)

MAIL_USERNAME=
MAIL_PASSWORD=
